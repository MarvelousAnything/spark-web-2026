---
import InstagramIcon from "../../public/socialIcons/instagram-logo.svg";
import GitHubIcon from "../../public/socialIcons/github-logo.svg";
import LinkedInIcon from "../../public/socialIcons/linkedin-logo.svg";
import SparkHacksLogo from "../assets/sparkhacks-logo.svg";
import { Image } from 'astro:assets';
---

<footer
	class="grid md:h-40 grid-flow-row grid-cols-1 md:grid-cols-3 gap-4 place-content-center items-center px-10 pb-8 md:pb-0 text-center text-white z-250"
	style="background: linear-gradient(#14270F 23%, #071D02 63%)"
>
	<div class="font-bold flex flex-col justify-center items-center">
		<a href="/"><Image src={SparkHacksLogo} class="w-25" alt="SparkHacks logo"/></a>
	</div>
	<div class="font-bold flex flex-col">
		<h1 class="tracking-widest">SparkHacks 2026</h1>
		<h2><a href="mailto:sparkhacks@uic.edu" target="_blank">sparkhacks@uic.edu</a></h2>
		<p>
			<a href="https://github.com/SparkHacks/spark-web-2026" target="_blank">{`Made by the SparkHacks team <3`}</a>
		</p>
	</div>
	<div class="flex flex-col font-bold">
		<h1 class="tracking-widest">Follow Us</h1>
		<div class="flex gap-5 justify-center">
			<a href="https://www.instagram.com/sparkhacksuic/" target="_blank">
				<div class="w-15">
					<g><InstagramIcon width="100%" height="100%" /></g>
				</div>
			</a>
			<a href="https://github.com/SparkHacks" target="_blank">
				<div class="w-15">
					<g><GitHubIcon width="100%" height="100%" /></g>
				</div>
			</a>
			<a href="https://www.linkedin.com/company/sparkhacks/" target="_blank">
				<div class="w-15">
					<g><LinkedInIcon width="100%" height="100%" /></g>
				</div>
			</a>
		</div>
	</div>
</footer>
